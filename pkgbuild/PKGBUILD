pkgname=gel
pkgver=0.1.0
pkgrel=1
pkgdesc='Annotate and quantify an agarose gel or Western blot, and export a publication figure'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-svg' 'qt6-imageformats' 'qt6-wayland' 'xdg-desktop-portal')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/gel "$pkgdir/usr/bin/gel"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/gel.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/gel.svg"
  install -Dm644 "$startdir/gel.desktop" "$pkgdir/usr/share/applications/gel.desktop"
  install -Dm644 "$startdir/gel.xml" "$pkgdir/usr/share/mime/packages/gel.xml"
}
